{
  "name": "@local/dsh-composer-studio",
  "version": "2.1.0",
  "description": "Turns the DSH composer into a real editor: Default mode is exactly stock DSH, while Markdown mode expands the composer into an immersive split view that renders Markdown as you type. Everything can be switched off in one place.",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "composer",
    "editor",
    "markdown",
    "keyboard",
    "shortcut"
  ],
  "license": "MIT",
  "author": "poker",
  "homepage": "https://github.com/pokereva/dsh-composer-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pokereva/dsh-composer-studio.git"
  },
  "bugs": {
    "url": "https://github.com/pokereva/dsh-composer-studio/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/harness.cjs",
    "check": "node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
